---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import ContactForm from '../components/ContactForm.astro';
import { firm, taglines, areas, alsoHandles, bio, pullQuote } from '../content';
---
<Base>
  <div class="mx-auto max-w-3xl px-6">
    <header class="flex items-center justify-between py-10">
      <a href="#top" aria-label="Law Office of Mark Cohan, home"><Wordmark class="text-[0.7rem] sm:text-xs" /></a>
      <a href={firm.phoneHref} class="font-semibold underline underline-offset-4">{firm.phone}</a>
    </header>

    <main id="main">
      <section id="top" class="py-20 sm:py-28">
        <h1 class="text-4xl font-medium leading-[1.12] sm:text-6xl">{pullQuote}</h1>
        <p class="mt-8 text-xl leading-relaxed text-muted">I’ll treat you like a person, not just a case. I’ll actually return your phone calls and make sure you understand exactly what’s going on in your case. <span class="whitespace-nowrap">— Mark Cohan</span></p>
        <p class="mt-10"><a href="#contact" class="btn">Tell us about your case</a></p>
      </section>

      <section aria-labelledby="areas-h" class="border-t border-ink/15 py-16">
        <h2 id="areas-h" class="text-sm font-semibold uppercase tracking-[0.25em] text-accent">Where Mark can help</h2>
        <ul class="mt-8 divide-y divide-ink/15 border-y border-ink/15">
          {areas.map((a) => (
            <li class="py-5"><span class="font-serif text-2xl sm:text-3xl">{a.title}</span></li>
          ))}
        </ul>
        <p class="mt-6 text-muted">Also: {alsoHandles.join(' · ').toLowerCase()}.</p>
      </section>

      <section aria-labelledby="about-h" class="border-t border-ink/15 py-16">
        <h2 id="about-h" class="text-sm font-semibold uppercase tracking-[0.25em] text-accent">About</h2>
        <div class="mt-8 flex flex-col gap-8 sm:flex-row">
          <img src="/images/mark.jpg" alt="Portrait of attorney Mark Cohan" width="533" height="800" loading="lazy" class="h-56 w-auto self-start rounded object-cover grayscale" />
          <div class="space-y-5 text-lg leading-relaxed">{bio.map((p) => <p>{p}</p>)}</div>
        </div>
      </section>

      <section id="contact" class="border-t border-ink/15 py-16">
        <h2 id="contact-heading" class="font-serif text-3xl">Contact</h2>
        <p class="mt-4 text-lg">{taglines[1]} Call <a class="font-semibold underline underline-offset-4" href={firm.phoneHref}>{firm.phone}</a> or write below.</p>
        <div class="mt-10"><ContactForm /></div>
        <address class="mt-10 not-italic text-muted">{firm.street}, {firm.city}, {firm.region} {firm.zip} · <a class="underline underline-offset-4" href={`mailto:${firm.email}`}>{firm.email}</a></address>
      </section>
    </main>

    <footer class="border-t border-ink/15 py-10 text-sm text-muted">
      <p>© {new Date().getFullYear()} {firm.name}. General information only, not legal advice. Contacting the firm does not create an attorney–client relationship.</p>
    </footer>
  </div>
</Base>
