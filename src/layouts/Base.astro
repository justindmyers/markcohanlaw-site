---
import '../styles/global.css';
import { firm } from '../content';
interface Props { title?: string; description?: string }
const { title = `${firm.name} | Dallas, Texas`, description = 'Personal injury, family law, and wills and estates attorney in Dallas, Texas. Mark Cohan returns your calls and treats you like a person, not a case.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: firm.name,
  url: 'https://markcohanlaw.com/',
  telephone: '+1-214-369-9871',
  email: firm.email,
  address: { '@type': 'PostalAddress', streetAddress: firm.street, addressLocality: firm.city, addressRegion: firm.region, postalCode: firm.zip, addressCountry: 'US' },
  areaServed: 'Dallas, Texas',
  employee: { '@type': 'Person', name: firm.person, jobTitle: 'Attorney' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body class="min-h-dvh antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:rounded">Skip to content</a>
    <slot />
  </body>
</html>
